generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model User {
  id            String         @id @default(cuid())
  username      String         @unique @db.VarChar(30)
  passwordHash  String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
  orders        Order[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Category {
  id          Int        @id @default(autoincrement())
  name        String     @db.VarChar(100)
  persianName String?    @db.VarChar(100)
  slug        String     @unique @db.VarChar(120)
  parentId    Int?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]

  @@index([parentId])
  @@index([isActive])
  @@map("categories")
}

model Product {
  id              Int         @id @default(autoincrement())
  name            String      @db.VarChar(200)
  persianName     String?     @db.VarChar(200)
  description     String?     @db.Text
  descriptionFa   String?     @db.Text
  imageUrl        String?     @db.VarChar(1000)
  priceIrr        Decimal     @map("price") @db.Decimal(14, 0)
  priceUsd        Decimal?    @db.Decimal(12, 2)
  stock           Int         @default(0)
  discountPercent Int         @default(0)
  rating          Float       @default(0)
  ratingCount     Int         @default(0)
  attributes      Json        @default("{}")
  attributesFa    Json        @default("{}")
  categoryId      Int
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  category        Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems      OrderItem[]

  @@index([categoryId, isActive])
  @@index([isActive, createdAt])
  @@index([name])
  @@map("products")
}

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique @default(cuid())
  userId         String?
  status         OrderStatus @default(PENDING)
  fullName       String      @db.VarChar(160)
  email          String      @db.VarChar(254)
  phone          String      @db.VarChar(40)
  nationalId     String?     @db.VarChar(30)
  address        String      @db.VarChar(1000)
  notes          String?     @db.Text
  latitude       Float
  longitude      Float
  currency       String      @default("USD") @db.VarChar(3)
  subtotalUsd    Decimal     @db.Decimal(12, 2)
  taxUsd         Decimal     @db.Decimal(12, 2)
  shippingUsd    Decimal     @default(0) @db.Decimal(12, 2)
  totalUsd       Decimal     @db.Decimal(12, 2)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  user           User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items          OrderItem[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  productId       Int
  productName     String   @db.VarChar(200)
  productImageUrl String?  @db.VarChar(1000)
  quantity        Int
  unitPriceUsd    Decimal  @db.Decimal(12, 2)
  unitPriceIrr    Decimal  @db.Decimal(14, 0)
  lineTotalUsd    Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}
