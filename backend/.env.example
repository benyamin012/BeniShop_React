# Local PostgreSQL connection (replace YOUR_PASSWORD locally)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/benishop?schema=public"

# API server
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Replace these placeholders with long random secrets before implementing auth.
ACCESS_TOKEN_SECRET=replace-with-a-random-secret-of-at-least-32-characters
REFRESH_TOKEN_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
