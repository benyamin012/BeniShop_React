# Copy this file to .env in the backend folder and replace every placeholder.
# Keep .env local; never commit real credentials or secrets.

# Local PostgreSQL connection (replace YOUR_PASSWORD with your PostgreSQL password)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/benishop?schema=public"

# API server
NODE_ENV=development
PORT=4000

# Comma-separated frontend origins; Vite may use 5173 or 5174 if 5173 is busy.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Use two different random secrets, each at least 32 characters long.
ACCESS_TOKEN_SECRET=replace-with-a-random-secret-of-at-least-32-characters
REFRESH_TOKEN_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
